# Configuração do Application Tracker. Crie o .env com:  cd backend && uv run tracker-init --email=voce@gmail.com
# (gera os segredos sozinho). Passo a passo de cada chave: docs/guia-configuracao.md. Nunca versione o .env.

APP_ENV=dev
APP_BASE_URL=http://localhost:3100
API_BASE_URL=http://localhost:8000
# Segredos: o tracker-init preenche. Vazios, valem padrões de desenvolvimento (inseguros fora do seu PC).
SECRET_KEY=
ENCRYPTION_KEY=
# Seu e-mail: o único que pode entrar no dashboard.
AUTH_ALLOWED_EMAIL=
# Só no seu PC: botão "Entrar (desenvolvimento)" sem login Google. Só funciona acessando por localhost.
# Desligue (false) se expuser o app na rede ou na internet.
AUTH_DEV_LOGIN=true
USER_TIMEZONE=America/Sao_Paulo
# Hosts extras aceitos pela API (os de APP_BASE_URL e API_BASE_URL já entram). Ex.: ["tracker.minhavps.com"]
# ALLOWED_HOSTS=[]

# Banco e fila (sobem com: docker compose -f infra/docker-compose.yml up -d; só escutam em 127.0.0.1)
DATABASE_URL=postgresql+asyncpg://tracker:tracker@localhost:5433/tracker
REDIS_URL=redis://localhost:6379/0
# Tarefas em paralelo no worker (cada uma pode abrir um `claude -p`). 2 é seguro em PCs com 8 GB.
WORKER_CONCURRENCY=2

# Arquivos (PDFs dos currículos): pasta local (padrão data/storage) ou s3 (R2/B2/S3)
STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=/caminho/absoluto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# IA. Sem chave de API, o app usa o seu Claude Code (CLI `claude`, logado com a sua assinatura): nada a preencher.
# Com ANTHROPIC_API_KEY (console.anthropic.com, pago por uso), usa a API.
# AI_BACKEND=auto            # auto | api | claude_code | ollama
# CLAUDE_CODE_CMD=claude     # caminho do CLI, se não estiver no PATH
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=30
AI_MODEL_DEFAULT=claude-opus-5-5
# Extração em massa de vagas com modelo mais leve (poupa o limite da assinatura)
AI_MODEL_JOB_EXTRACT=claude-sonnet-5-5
# Ollama local: AI_BACKEND=ollama, com modelo disponível em http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_S=900

# Google (Gmail + Agenda): ID do cliente OAuth do tipo "Aplicativo da Web". Guia: docs/guia-configuracao.md#google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: fixa a conta do Gmail. Vazio = a conta que você conectar no dashboard.
GMAIL_ACCOUNT=
# Opcional (só com API pública): push do Gmail via Pub/Sub. Sem isso, o Gmail é lido a cada 5 minutos.
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
GMAIL_PUSH_SECRET=

# Telegram (notificações e comandos). Guia: docs/guia-configuracao.md#telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# auto: busca mensagens por polling quando a API é local (não precisa de URL pública)
# TELEGRAM_MODE=auto
TELEGRAM_WEBHOOK_SECRET=

# Backup: comando do pg_dump (com o Postgres do docker compose)
BACKUP_PG_DUMP_CMD=docker exec tracker-postgres pg_dump -U tracker tracker

# Compilador LaTeX para os PDFs dos currículos (tectonic recomendado; veja o README)
LATEX_CMD=tectonic

SENTRY_DSN=
